HTTP_ADDR=:8081
SERVICE_NAME=identity-service
IDENTITY_API_NETWORK=drp-dev_default
# Corte 2 seed only (same accounts as drp-front hints). Leave empty to use Spacehub1!.
IDENTITY_SEED_PASSWORD=Spacehub1!
# Empty = ephemeral RSA at boot (dev). qa/main: inject PEM via env/secrets; never commit a key file.
JWT_PRIVATE_KEY_PEM=
JWT_KID=spacehub-identity-2026
# Empty = in-memory Corte 2 seed. After Flyway (drp-identity-db) point at the
# composition-root engine. Host port is 5432 in env examples; this machine
# publishes Postgres on 5436 via env/dev.env.
DATABASE_URL=postgres://identity_app:change-me-identity@localhost:5432/drp?sslmode=disable
