# Compose (pass with --env-file). Host process still uses ../.env.example (localhost DSN).
# Also pass sibling drp-infra-postgres/env/dev.env so IDENTITY_APP_PASSWORD matches.
COMPOSE_PROJECT_NAME=drp-dev
DRP_ENV=dev
HTTP_PORT=8081
# Required in env/dev.env (gitignored). Empty here so compose fails closed.
IDENTITY_SEED_PASSWORD=
